{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "services": {
    "web": {
      "root": "web",
      "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/scripts/vercel_ignore.sh\""
    },
    "api": {
      "root": ".",
      "entrypoint": "api/main.py",
      "installCommand": "pip install '.[rhino,mesh,web]' && \"$(dirname \"$(command -v pip)\")/python\" scripts/trim_site_packages.py",
      "functions": {
        "api/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,out/**,web/**,docs/**,scripts/**,**/__pycache__/**}"
        }
      },
      "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/scripts/vercel_ignore.sh\""
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
