{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web"
    },
    "api": {
      "root": ".",
      "entrypoint": "api/main.py",
      "installCommand": "pip install '.[rhino,mesh,web]'",
      "functions": {
        "api/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{{tests,out,web,docs}/**,**/__pycache__/**,**/site-packages/**/{tests/**,*.pyx,*.pxd,*.pyi,*.h,*.hpp,*.c,*.cpp},**/site-packages/pyarrow/{include/**,libarrow_flight*,_flight*}}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
