{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web"
    },
    "api": {
      "root": ".",
      "entrypoint": "api/main.py",
      "installCommand": "pip install '.[rhino,mesh,web]'",
      "functions": {
        "api/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,out/**,web/**,docs/**,**/__pycache__/**,**/site-packages/**/tests/**,**/site-packages/**/*.pyx,**/site-packages/**/*.pxd,**/site-packages/**/*.pyi,**/site-packages/**/*.h,**/site-packages/**/*.hpp,**/site-packages/**/*.c,**/site-packages/**/*.cpp,**/site-packages/pyarrow/include/**,**/site-packages/pyarrow/libarrow_flight*,**/site-packages/pyarrow/_flight*}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
